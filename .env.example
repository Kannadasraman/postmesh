# ==========================================
# PostMesh Development Environment
# ==========================================

# Application
APP_NAME=PostMesh
APP_ENV=development

# Backend
BACKEND_PORT=8002

# Frontend
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=postmesh
POSTGRES_USER=postmesh
POSTGRES_PASSWORD=postmesh_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Database URL
DATABASE_URL=postgresql+psycopg://postmesh:postmesh_dev_password@postgres:5432/postmesh

# Redis URL
REDIS_URL=redis://redis:6379/0